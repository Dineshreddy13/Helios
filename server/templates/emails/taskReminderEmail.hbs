<h1 class="heading">Task Reminder</h1>
<p class="text">Hi {{name}},</p>
<p class="text">This is a friendly reminder for your upcoming task:</p>

<div class="section">
    <p class="task-title">{{taskTitle}}</p>
    <p class="task-date">Scheduled for: <strong>{{reminderAtFormatted}}</strong></p>
</div>

<p class="text">Please check your dashboard to review the task details.</p>

<p class="text-xs">You are receiving this email because a reminder was set for this task.</p>
