<h1 class="heading">Verify your email</h1>
<p class="text">Hi {{name}},</p>
<p class="text">Your OTP verification code is:</p>

<div class="section">
    <p class="otp">{{otp}}</p>
</div>

<p class="text-sm">Request ID: <strong>{{requestId}}</strong></p>
<p class="text">This code expires in <strong>{{expiry}}</strong>.</p>

<p class="text-xs">If you didn't request this, ignore this email.</p>
