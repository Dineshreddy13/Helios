<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body { background-color: #ffffff; font-family: sans-serif; color: #1f2937; margin: 0; padding: 0; }
        .container { margin: 40px auto; max-width: 32rem; padding: 24px; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
        .heading { font-size: 24px; font-weight: bold; color: #4f46e5; margin-bottom: 16px; margin-top: 0; }
        .text { font-size: 16px; margin-bottom: 16px; margin-top: 0; }
        .section { background-color: #f9fafb; border-radius: 4px; padding: 24px; text-align: center; margin: 24px 0; }
        .otp { font-size: 36px; font-weight: bold; letter-spacing: 0.1em; color: #4f46e5; margin: 0; }
        .text-sm { font-size: 14px; color: #6b7280; margin-bottom: 24px; margin-top: 0; }
        .text-xs { font-size: 12px; color: #9ca3af; margin-top: 40px; margin-bottom: 0; }
        .task-title { font-size: 20px; font-weight: bold; color: #1f2937; margin: 0 0 8px 0; }
        .task-date { font-size: 16px; color: #4b5563; margin: 0; }
    </style>
</head>
<body>
    <div class="container">
        {{{body}}}
    </div>
</body>
</html>
